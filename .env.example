# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_products,write_inventory,read_orders

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ebay_sync

# Redis
REDIS_URL=redis://localhost:6379

# Encryption key for credentials at rest (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# eBay OAuth 2.0 redirect URI (RuName from eBay developer portal)
# This is the URL eBay redirects to after user consent
EBAY_REDIRECT_URI=
