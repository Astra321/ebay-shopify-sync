{
  "name": "ebay-shopify-sync",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr",
    "postinstall": "prisma generate",
    "dev": "vite dev",
    "dev:shopify": "shopify app dev",
    "start": "remix-serve ./build/server/index.js",
    "start:standalone": "STANDALONE=true remix-serve ./build/server/index.js",
    "deploy": "prisma migrate deploy && remix-serve ./build/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx watch worker/sync-worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/app-bridge-react": "^4.0.0",
    "@shopify/polaris": "^13.9.0",
    "@shopify/polaris-icons": "^9.3.0",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-remix": "^4.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "axios": "^1.7.9",
    "bullmq": "^5.30.0",
    "fast-xml-parser": "^4.5.1",
    "ioredis": "^5.4.2",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
