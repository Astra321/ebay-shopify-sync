# ─── Standalone / Demo Mode ──────────────────────────────────
# Set to "true" to run the app without Shopify, database, or Redis.
# The app will serve the landing page at / and demo dashboard at /demo.
STANDALONE=true

# ─── Shopify (required for production, not needed in standalone mode) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_products,write_inventory,read_orders

# ─── Database (required for production, not needed in standalone mode) ──
DATABASE_URL=postgresql://user:password@localhost:5432/ebay_sync

# ─── Redis (required for production, not needed in standalone mode) ──
REDIS_URL=redis://localhost:6379

# ─── Encryption key (required for production) ────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── eBay OAuth 2.0 (required for production) ───────────────
EBAY_REDIRECT_URI=
